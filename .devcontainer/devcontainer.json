{
  "name": "ETL Kafka Blocks Lab",
  "dockerComposeFile": [
    "docker-compose.yml",
    "../docker-compose.yml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Blockly teaching app",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install -r runtime/requirements.txt && cd frontend && npm install"
}
